<launch>
    <param name = "/use_sim_time" value = "/false" />

    <node name = "cartographer_node" pkg = "cartographer_ros" type = "cartographer_node"
        args = "-configuration_directory $(find amr_config)/cfg
                -configuration_basename bag_mapping_300.lua">
                <remap from="scan" to="scan_map_sim" />
    </node>

    <node name="rviz" pkg="rviz" type="rviz" args="-d $(find amr_config)/mapping.rviz"/>
    <node name = "laser_change" pkg = "amr_config" type = "timeIncrement.py" ></node>
    <node name = "cartographer_occupancy_grid_node" pkg = "cartographer_ros" type = "cartographer_occupancy_grid_node" args = "-resolution 0.05">


    </node>
  </launch>