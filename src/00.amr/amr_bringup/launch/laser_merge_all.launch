<launch>
    <!-- Arguments -->
    <include file="$(find amr_bringup)/launch/static_tf.launch" />
    <include file="$(find amr_bringup)/launch/lidar_signal_new.launch" />

    <node pkg="ira_laser_tools" name="laserscan_multi_merger" type="laserscan_multi_merger_intensity" output="screen">
		<param name="destination_frame" value="laser"/>
		<param name="cloud_destination_topic" value="/merged_cloud"/>
		<param name="scan_destination_topic" value="/scan_map"/>
		<param name="laserscan_topics" value ="/scan_1 /scan_2" />
		<!-- <param name="laserscan_topics" value ="/scan_vl53l5cx" /> -->
		<param name="angle_min" value="-3.14"/>
		<param name="angle_max" value="3.14"/>
		<param name="angle_increment" value="0.0004363763"/>
		<param name="scan_time" value="0.0333333"/>
		<param name="range_min" value="0.30"/>
		<param name="range_max" value="30.0"/>
	</node>




</launch>
