<launch>
  <arg name="start_trajectory_with_default_topics" default="true" />
  <arg name="lightweight_visualization" default="false" />
  <arg name="scan_topic" default="/scan_map_filter" />
  <arg name="configuration_directory" default="$(find cartographer_run)/configuration_files" />
  <arg name="configuration_basename" default="localization_config.lua" />
  <arg name="map_file" default="/home/mkac/tmp/ros/maps/ems_3" />

  <node name="cartographer_node_localization" pkg="cartographer_ros"
      type="cartographer_node" args="
          -configuration_directory $(arg configuration_directory)
          -configuration_basename $(arg configuration_basename)
          -load_state_filename $(arg map_file).pbstream
          -start_trajectory_with_default_topics=$(arg start_trajectory_with_default_topics)"
      output="log">
    <remap from="scan" to= "$(arg scan_topic)" />
  </node>

  <node pkg="cartographer_run" name="cartographer_initialpose_setter" type="initialpose.py" output="log">
		<param name="configuration_directory" value="$(arg configuration_directory)" />
		<param name="configuration_basename" value="$(arg configuration_basename)" />
	</node>

  <node pkg="cartographer_run" name="relocalization_cartographer_server" type="relocalization_server.py" output="log">
		<param name="increase_degree" value= "360" />
		<param name="time_wait_one_cycle" value= "20" />
	</node>

  <!-- <node name="cartographer_occupancy_grid_localization" pkg="cartographer_ros"
      type="cartographer_occupancy_grid_node" args="-resolution 0.05" output="log">
    <param name="publish_period_sec" value="1.0"/>
  </node> -->

  <!-- Node map_server -->
  <!-- Fix in slam_config -->
  <node name="map_server" pkg="map_server" type="map_server" args="$(arg map_file).yaml" output="log"/>

</launch>