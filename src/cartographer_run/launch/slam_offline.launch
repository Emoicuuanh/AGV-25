<launch>
  <param name="/use_sim_time" value="true" />
  <arg name="skip_seconds" default="0" />

  <node name="cartographer_offline_node" pkg="cartographer_ros"
      required="$(arg no_rviz)"
      type="cartographer_offline_node" args="
          -configuration_directory $(find cartographer_run)/configuration_files
          -configuration_basenames slam_config.lua
          -bag_filenames $(arg bag_filenames)
          -skip_seconds $(arg skip_seconds)
          -collect_metrics"
      output="screen">
      <remap from="scan" to="scan_map_filter" />
  </node>
</launch>
