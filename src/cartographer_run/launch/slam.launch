<launch>
  <!-- Dùng thời gian từ /clock khi chạy rosbag -->
  <!-- <param name="use_sim_time" value="true"/> -->

  <node name="cartographer_node_slam" pkg="cartographer_ros"
      type="cartographer_node" args="
          -configuration_directory $(find cartographer_run)/configuration_files
          -configuration_basename slam_config.lua
          -collect_metrics"
      output="log">
      <remap from="scan" to="scan_map_filter" />
  </node>

  <node name="cartographer_occupancy_grid_slam" pkg="cartographer_ros"
        type="cartographer_occupancy_grid_node" args="-resolution 0.05" output="log">
      <param name="publish_period_sec" value="1.0"/>
  </node>
</launch>
