<launch>
      <!-- <param name="use_sim_time" value="true" /> -->
      <arg name="map_file" default="/home/mkac/tmp/ros/maps/test_test" />

      <node name="cartographer_node_static_map" pkg="cartographer_ros"
            type="cartographer_node"
            output="log"
            args="-configuration_directory $(find cartographer_run)/configuration_files
                -configuration_basename fix_map.lua
                -load_state_filename $(arg map_file).pbstream
                -start_trajectory_with_default_topics=false
                -load_frozen_state=false" />
      <node name="cartographer_occupancy_grid_static" pkg="cartographer_ros"
            type="cartographer_occupancy_grid_node" args="-resolution 0.05" output="log">
            <param name="publish_period_sec" value="1.0" />
      </node>
</launch>